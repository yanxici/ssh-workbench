{
  "name": "ssh-workbench",
  "version": "1.6.13",
  "private": true,
  "description": "轻量级 SSH 客户端 + 嵌入式技术支持工作台",
  "author": "ssh-workbench",
  "repository": {
    "type": "git",
    "url": "https://github.com/yanxici/ssh-workbench.git"
  },
  "homepage": "https://github.com/yanxici/ssh-workbench",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "lint:scripts": "eslint \"scripts/**/*.cjs\"",
    "lint:all": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.cjs\"",
    "check": "npm run typecheck && npm run lint",
    "test:shellcwd": "node scripts/verify-shellcwd.cjs",
    "test:cwdstore": "node scripts/verify-cwdstore.cjs",
    "test:cwdfollow": "node scripts/verify-shellcwd.cjs && node scripts/verify-cwdstore.cjs && node scripts/verify-cwdfollow.cjs",
    "test:hostkey": "node scripts/verify-hostkey.cjs",
    "test:uploadfolder": "node scripts/verify-upload-folder.cjs",
    "test:uploadsession": "node scripts/verify-upload-session.cjs",
    "test:ipc": "electron scripts/verify-ipc-registration.cjs",
    "test:repository": "node scripts/verify-repository-split.cjs",
    "test:features": "node scripts/verify-hostkey.cjs && node scripts/verify-upload-folder.cjs && node scripts/verify-upload-session.cjs",
    "test:stress": "node scripts/stress-test.js && node scripts/stress-cwd.cjs",
    "test:stress:e2e": "electron scripts/stress-e2e.cjs",
    "icon": "node scripts/make-icon.cjs",
    "check:integrity": "pwsh -NoProfile -File scripts/check-integrity.ps1",
    "fix:integrity": "pwsh -NoProfile -File scripts/check-integrity.ps1 -Fix",
    "guard:integrity": "pwsh -NoProfile -File scripts/check-integrity.ps1 -Guard",
    "unguard:integrity": "pwsh -NoProfile -File scripts/check-integrity.ps1 -Unguard",
    "smoke": "electron-vite build && electron . --smoke",
    "smoke:cdp": "node scripts/smoke-cdp.cjs",
    "build:win": "pwsh -NoProfile -File scripts/check-integrity.ps1 && npm run typecheck && npm run test:features && electron-vite build && node scripts/e2e-ui-sftp.cjs && electron-builder --win --config electron-builder.yml",
    "build:win:portable": "electron-vite build && electron-builder --win portable --config electron-builder.yml",
    "build:mac": "electron-vite build && electron-builder --mac --config electron-builder.yml",
    "build:linux": "electron-vite build && electron-builder --linux --config electron-builder.yml",
    "test:ui": "node scripts/e2e-ui-sftp.cjs",
    "test:ui:stress": "node scripts/e2e-ui-sftp.cjs --stress",
    "test:verify": "node scripts/run-all-verify.cjs",
    "test:verify:list": "node scripts/run-all-verify.cjs --list",
    "verify:prepackage": "npm run typecheck && npm run test:features && npm run test:uploadfolder && npm run test:verify && electron-vite build && node scripts/e2e-ui-sftp.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ssh2": "^1.17.0",
    "zmodem.js": "0.1.10"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/ssh2": "^1.15.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "lucide-react": "^0.469.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  }
}
