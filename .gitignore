node_modules
out
dist
.vite
.tsc-verify
*.local
smoke-shot.png
*.log

# 打包产物 / 构建缓存
dist-*
*.tsbuildinfo
smoke-result.json
probe-*.json
*.err
# 冒烟用的临时 user-data-dir（内含整份业务数据副本，不要提交）
.smoke-*/

# 本地 Claude 设置
.claude/settings.local.json

# 内部专用脚本（含公司设备信息 / 明文密码），只留本地，不上传
scripts/set-charger-password.cjs
scripts/set-xcmd-passwords.cjs
scripts/switch-robot-to-password.cjs
scripts/import-xcmd.cjs
scripts/verify-xcmd-import.cjs
scripts/gen-rtu-commands.cjs
# 图标排查的临时产物（Electron user-data 缓存 / 任务栏截图）
.probe-icon/
/probe-*.png
/tb-*.png

# 一次性排查产物（上游包解压 / 抓包），不入库
_piai_probe/

# 本地发布产物归档（releases/v<ver>/ 只放当前最新版，旧版随发版清理）
# 不纳入版本库：安装包 ~80MB，仓库里没必要存二进制。
releases/

# 布局方案对比 demo 与一次性截图（本地验证产物，不入库）
.demo/
.shots/

# 字体渲染探针的一次性截图与设置副本（tmp-probe/*.png、*.json、*.py），不入库
tmp-probe/

# 串口原生模块 spike 的临时产物（asar 对照实验 / 结果 json）
serial-spike-result.json

# 字体渲染探针（probe-font7..15）：同一份脚本的逐次变体，只在本地跑，不入库
scripts/probe-font*.cjs

# 一次性排查脚本（截图 / 坐标标定 / CDP 探针），只在本地跑，不入库。
# _osclick.ps1 是 verify-tabmenu-os.cjs / verify-tabbar-os.cjs 的操作系统级点击依赖，必须入库。
scripts/_*
!scripts/_osclick.ps1

# 本地临时工作区与回归报告（截图、user-data-dir、e2e 日志）
.tmp/
reports/

# 一次性发版日志（release-notes-v<ver>.md）：已全部删除，Release 正文改由
# scripts/release-notes.cjs 从 CHANGELOG 现抽。这里再兜一层，防止顺手写回来。
release-notes-v*.md
release-notes-*.generated.md
